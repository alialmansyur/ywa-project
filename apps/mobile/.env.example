# API Configuration
# Generic fallback used when a platform-specific URL is not set.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Optional platform-specific overrides:
# Web browser on the same machine as the API:
# EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:8000/api/v1

# Android emulator -> host machine API:
# EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1

# iPhone / real device on the same LAN:
# EXPO_PUBLIC_API_BASE_URL_IOS=http://192.168.1.10:8000/api/v1

# Build Configuration
EXPO_PUBLIC_APP_ENV=development
